{
  "name": "forge-tester-tic-tac-toe",
  "version": "1.0.0",
  "private": true,
  "description": "A simple web based tic tac toe game to play with friends",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "NODE_ENV=DEV node scripts/dev-server.js",
    "start": "NODE_ENV=PROD node scripts/server.js",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "node scripts/ci-checks.js",
    "test:e2e": "node scripts/run-e2e.js",
    "test:e2e:direct": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:save-videos": "node scripts/save-videos.js",
    "test:e2e:generate-videos": "node scripts/generate-videos.js",
    "lint": "npm run lint --workspaces --if-present",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "dev:backend": "npm run dev --workspace=packages/backend"
  },
  "keywords": [
    "tic-tac-toe",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "next": "^16.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
